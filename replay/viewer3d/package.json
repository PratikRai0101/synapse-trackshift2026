{
  "name": "f1-viewer3d",
  "private": true,
  "type": "module",
  "workspaces": ["bridge", "web"],
  "scripts": {
    "dev": "bun run dev.ts",
    "dev:bridge": "bun run bridge/index.ts",
    "dev:web": "cd web && bun run dev",
    "mock": "bun run bridge/mock.ts",
    "shot": "bun run tools/screenshot.ts",
    "build": "cd web && bun run build",
    "typecheck": "bunx tsc --noEmit -p tsconfig.json && cd web && bun run typecheck"
  },
  "devDependencies": {
    "@types/bun": "latest",
    "playwright": "^1.63.0",
    "typescript": "^5.7.0"
  }
}
